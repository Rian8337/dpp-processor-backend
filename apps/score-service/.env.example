# Server
PORT=changeme
# HOST=127.0.0.1
API_KEY=changeme-at-least-16-characters

# The score service's own PostgreSQL database
DATABASE_HOST=localhost
# DATABASE_PORT=5432
DATABASE_NAME=changeme
DATABASE_USER=changeme
DATABASE_PASSWORD=changeme

# The official osu!droid MariaDB/MySQL database (read for scores, written for pp)
OFFICIAL_DB_HOST=localhost
# OFFICIAL_DB_PORT=3306
OFFICIAL_DB_NAME=changeme
OFFICIAL_DB_USER=changeme
OFFICIAL_DB_PASSWORD=changeme
# OFFICIAL_DB_PREFIX=bbl_

# MongoDB databases
ALICE_DB_URI=mongodb://changeme
ELAINA_DB_URI=mongodb://changeme

# The broker that routes calculations to processors
BROKER_URL=http://127.0.0.1:<port>
BROKER_API_KEY=changeme

# The beatmap service: priority lane key for interactive work, bulk lane key for recalculation
BEATMAP_SERVICE_URL=http://127.0.0.1:<port>
BEATMAP_SERVICE_KEY=changeme
BEATMAP_SERVICE_BULK_KEY=changeme

# Broker variant names used for live scores
LIVE_DROID_VARIANT=changeme
LIVE_OSU_VARIANT=changeme

# Replay folders (absolute paths)
UNPROCESSED_REPLAY_DIR=/path/to/unprocessed
ONLINE_REPLAY_DIR=/path/to/online
BEST_REPLAY_DIR=/path/to/best
UNCALCULATED_REPLAY_DIR=/path/to/uncalculated

# Discord backend endpoint that receives metadata updates
DISCORD_METADATA_URL=http://127.0.0.1:<port>/changeme
DISCORD_METADATA_KEY=changeme

# Background work
# REPLAY_CONCURRENCY=2
# UNCALCULATED_CONCURRENCY=1
# UNCALCULATED_INTERVAL_MINUTES=10
# DAN_COURSE_REFRESH_MINUTES=60
