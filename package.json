{
  "name": "dpp-processor-backend-new",
  "private": true,
  "description": "Services that calculate droid performance points",
  "author": "Rian8337",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "build:variant": "pnpm --filter @dpp/processor run build:variant",
    "test:e2e": "pnpm -r --workspace-concurrency=1 run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  }
}
