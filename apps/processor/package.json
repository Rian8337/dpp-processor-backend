{
  "name": "@dpp/processor",
  "private": true,
  "version": "1.0.0",
  "description": "Service that calculates difficulty and performance with one game mode and algorithm",
  "main": "dist/index.mjs",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --on-success \"node dist/index.mjs\"",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run -c vitest.e2e.config.mts",
    "db:generate": "drizzle-kit generate",
    "build:variant": "node scripts/build-variant.ts",
    "prune": "node dist/prune.mjs"
  },
  "author": "Rian8337",
  "license": "MIT",
  "dependencies": {
    "@dpp/shared": "workspace:*",
    "@rian8337/osu-base": "4.0.0-beta.100",
    "@rian8337/osu-difficulty-calculator": "4.0.0-beta.100",
    "@rian8337/osu-droid-replay-analyzer": "4.0.0-beta.100",
    "@rian8337/osu-rebalance-difficulty-calculator": "4.0.0-beta.100",
    "@rian8337/osu-strain-graph-generator": "4.0.0-beta.100",
    "canvas": "^3.2.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "piscina": "^5.3.2",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.3"
  }
}
